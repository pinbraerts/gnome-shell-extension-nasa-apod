#: extension.js:246
msgid ""
"Here will be displayed an explanation of the current NASA's APOD wallpaper. "
"Please press refresh to download a new wallpaper along with the explanation."
msgstr ""
"Hier wordt een omschrijving getoond, behorende bij de huidige afbeelding van "
"de dag. Klik op ‘Vernieuwen’ om een nieuwe afbeelding, inclusief "
"omschrijving, op te halen."

#: extension.js:276
msgid "Next refresh: {0}"
msgstr "Volgende vernieuwing: {0}"

#: extension.js:279
msgid "Next refresh in less than a minute"
msgstr "Er wordt over enkele momenten vernieuwd"

#: extension.js:351
msgid "Pending refresh"
msgstr "In afwachting van vernieuwing"

#: extension.js:355
msgid "Over rate limit (error 429)"
msgstr "Opvraaglimiet bereikt (foutcode 429)"

#: extension.js:356
msgid ""
"Get your API key at https://api.nasa.gov/ to have 1000 requests per hour "
"just for you."
msgstr ""
"Haal een api-sleutel op op https://api.nasa.gov/ om 1000 opvragingen per uur "
"te mogen doen."

#: extension.js:395
msgid "Error downloading image"
msgstr "De afbeelding kan niet worden opgehaald"

#: extension.js:400
msgid "Invalid NASA API key (error 403)"
msgstr "Ongeldige api-sleutel (foutcode 403)"

#: extension.js:401
msgid "Check that your key is correct or use the default key."
msgstr "Controleer of de sleutel klopt of gebruik de standaardsleutel."

